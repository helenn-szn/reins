# Copy this file to .env.local and fill in what you have. Never commit .env.local.

# --- SERV Reasoning (console.openserv.ai) ---
# Leave empty to run in mock mode with no credits used.
SERV_API_KEY=
SERV_MODEL=gpt-6-luna
# SERV_BASE_URL=https://inference-api.openserv.ai/v1

# --- Payments ---
# "mock" = fake payments, nothing on-chain. "kite" = real x402 payments on Kite testnet.
# "passport" = real USDC through your Kite Agent Passport (local only, needs kpass).
PAYMENTS_MODE=mock
# The Reins agent wallet (the spending pot). Testnet only: never put a key that holds real money here.
# KITE_AGENT_PRIVATE_KEY=0x...
# Where the demo shops get paid (default: the project's demo shop wallet)
# SHOP_PAY_TO=0x...
# Share of the price paid on-chain. 0.01 = 1/100, so faucet money lasts. 1 = full price.
# KITE_PAY_SCALE=0.01
# Secret for the /api/selftest and /api/kite/test checks. Leave empty to turn them off.
# KITE_TEST_KEY=

# --- Kite Agent Passport (only on your own computer) ---
# Set PAYMENTS_MODE=passport above to pay from your Passport wallet through Kite's kpass app.
# Real USDC; Kite enforces the allowance you set in the Passport dashboard.
# Full path to kpass if it isn't on your PATH
# KPASS_BIN=kpass

# --- Kite testnet ---
# Token used for balances and payments. Default is the faucet's "Test USD" (USDT).
# WALLET_TOKEN_ADDRESS=0x0fF5393387ad2f9f691FD6Fd28e07E3969e27e63
# KITE_RPC_URL=https://rpc-testnet.gokite.ai/
# KITE_EXPLORER_API=https://testnet.kitescan.ai/api/v2
