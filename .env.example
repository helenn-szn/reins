# Copy this file to .env.local and fill in what you have. Never commit .env.local.

# SERV Reasoning (console.openserv.ai). Leave empty to run in mock mode with no credits used.
SERV_API_KEY=
# Cheapest model while building; switch to gpt-5.4-mini if answers aren't good enough.
SERV_MODEL=gpt-6-luna
# SERV_BASE_URL=https://inference-api.openserv.ai/v1

# Payments: "mock" (fake transactions) until Kite Passport is wired in, then "kite".
PAYMENTS_MODE=mock

# Read-only wallet on Kite testnet. Default token is the faucet's "Test USD".
# Swap to pieUSD (0x38129cf4CE5E183eFF248F42A7D345Bb1B47621A) if the Kite team confirms it.
# WALLET_TOKEN_ADDRESS=0x0fF5393387ad2f9f691FD6Fd28e07E3969e27e63
# KITE_RPC_URL=https://rpc-testnet.gokite.ai/
